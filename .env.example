# ------------------------------------------------------------------
# biasly 环境变量规范清单（AGENTS.md §21）
# 仅 NEXT_PUBLIC_* 前缀的变量可到达浏览器端；其余均为服务端专用。
# 复制为 .env.local 并填写真实值。切勿提交 .env.local。
# ------------------------------------------------------------------

# Clerk 身份验证
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_FALLBACK_REDIRECT_URL=/

# Supabase 数据持久化
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Oxylabs Web Scraper API 与调度器
OXY_WSA_USERNAME=
OXY_WSA_PASSWORD=

# AI 分析（qwen3.7-plus，千问 AI 平台 OpenAI 兼容协议）
ANALYSIS_MODEL_NAME=qwen3.7-plus
ANALYSIS_API_KEY=
# 可选：自定义 OpenAI 兼容端点（缺省 https://dashscope.aliyuncs.com/compatible-mode/v1）
ANALYSIS_BASE_URL=

# 管理员密钥：操作路由要求 x-biasly-admin-secret 请求头
BIASLY_ADMIN_SECRET=

# 可选：每批次分析的文章数量（默认 5）
ANALYSIS_BATCH_SIZE=5

# Vercel Cron 密钥：由 Vercel 在每个 Cron 请求中自动注入，
# 切勿添加到 .env.local
# CRON_SECRET=
